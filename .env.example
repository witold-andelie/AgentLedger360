# Copy to .env (or set in the shell). Every process that signs or verifies receipts MUST share AL_PAYMENT_SECRET.
AL_VAR_DIR=var
AL_PAYMENT_SECRET=change-me-shared-between-both-laptops
AL_FEE_BPS=200
# FUNDS_HELD orders older than this are cancelled and fully refunded (POST /orders/expire).
AL_ORDER_TTL_SECONDS=300
# Prices: synthetic (deterministic, offline) | yfinance (needs `.[data]` + internet)
AL_DATA_SOURCE=synthetic
# What this web process serves: all (API + clearing house + sellers) | sellers (seller agents only)
AL_ROLE=all
# Buyer side: base URL of a remote seller service; empty = sellers run in-process
AL_SELLER_URL=
# Seller side: public base URL advertised in agent cards (e.g. http://192.168.1.20:8002)
AL_SELLER_PUBLIC_URL=inproc://sellers
# Built frontend served at "/" (Dockerfile sets /app/frontend/dist)
AL_FRONTEND_DIST=frontend/dist
# If set, the "Reset demo" button (POST /api/demo/reset) asks for this token. Leave empty on a laptop.
AL_ADMIN_TOKEN=
# Capability switches (default: public signup cannot mint money, market is open, one order <= $5.00)
AL_CAP_OPEN_FUNDING=0
AL_CAP_LLM_RULINGS=1
AL_CAP_MARKET_PAUSED=0
AL_CAP_MAX_ORDER_MINOR=500
# Disputes above this amount (cents) wait for a person. 50000 = $500, above the demo orders.
AL_CAP_HUMAN_REVIEW_ABOVE_MINOR=50000
# Public cost guard. Past the daily budget a round runs the rule agent instead of the LLM.
AL_DAILY_AI_BUDGET_USD=2.00
# If set, starting a round requires header X-Run-Token (the page asks once per visit).
AL_RUN_TOKEN=
# Minimum seconds between rounds from the same IP. 0 disables the limit (tests).
AL_ROUND_MIN_INTERVAL_SECONDS=60
# ---- AI agents (LangGraph buyer + guardian; needs `.[agent]`) ----
# auto = LLM agents when the provider key below is set, otherwise rule-based agents | llm | rule
AL_AGENT_MODE=auto
# mistral (default) | anthropic | openai_compat (DeepSeek, OpenRouter, vLLM, ... via AL_LLM_BASE_URL)
AL_LLM_PROVIDER=mistral
# Empty = provider default: mistral-medium-latest | claude-opus-5-5 | deepseek-v4-flash
AL_LLM_MODEL=
AL_LLM_BASE_URL=
# Keys: MISTRAL_API_KEY / ANTHROPIC_API_KEY / AL_LLM_API_KEY (or DEEPSEEK_API_KEY). Never commit them.
MISTRAL_API_KEY=
# Budgets per agent run (revio-style): the loop stops at whichever is hit first
AL_AGENT_MAX_TOOL_CALLS=30
AL_AGENT_MAX_COST_USD=0.50
# Optional price override in USD per 1M tokens (the built-in table is in agents/accounting.py)
AL_LLM_PRICE_IN=
AL_LLM_PRICE_OUT=
